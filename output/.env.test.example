# Copy root .env to output/.env.test and override these keys only.
RAY_NAMESPACE=lexis-markets-test
MARKETS_LAKE_PREFIX=test/
POSTGRES_FAST_URL=postgresql://postgres:PASSWORD@HOST:5433/lexis_markets_test
POSTGRES_FAST_DB=lexis_markets_test
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5433/lexis_markets_test
MARKETS_SUPERVISOR_STATE=output/.supervisor-test/state.db
MARKETS_TEST_PROFILE=1
MARKETS_TEST_EOD_FULL_PATH=1
MARKETS_TEST_WEEK_START=2025-03-11
MARKETS_TEST_WEEK_DAYS=7
MARKETS_TEST_SYMBOLS=AAPL,MSFT,SPY
MARKETS_TEST_ALIGN_SYMBOLS=AAPL
MARKETS_TEST_FRED_SERIES=DFF,DGS10,UNRATE
MARKETS_TEST_YF_LIMIT=3
MARKETS_TEST_EOD_YF_LIMIT=3
MARKETS_TEST_QUALITY_LIMIT=6
# Clipped automatically by weeksim clock; override only if needed:
# MARKETS_TEST_EOD_START=2024-11-01
