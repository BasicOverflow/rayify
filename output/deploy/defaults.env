# Non-secret defaults for lexis-markets LXC deploy.
# Override by exporting vars before install.

# Proxmox guest
CTID=117
CT_HOSTNAME=lexis-markets-supervisor
CT_IP=10.0.0.58
CT_GW=10.0.0.1
CT_CIDR=16
BRIDGE=vmbr0
STORAGE=TN-VM-Backup
TEMPLATE_STORAGE=local
OSTEMPLATE=debian-12-standard_12.12-1_amd64.tar.zst
MEMORY=512
CORES=2
DISK_GB=32
UNPRIVILEGED=1
FEATURES=nesting=0
START_ON_BOOT=1
HA_GROUP=

# App paths inside CT
APP_ROOT=/opt/lexis-markets
APP_USER=lexis
STATE_DIR=/var/lib/lexis-markets
ENV_FILE=/etc/lexis-markets.env

# Creds: private Gitea repo with the real cluster .env (token from host file only)
CREDS_REPO_RAW=http://10.0.0.52:3000/admin/rayify_real_infra_creds/raw/branch/main/.env

# Public Gitea app repo (code)
REPO_RAW_BASE=http://10.0.0.52:3000/admin/lexis-markets/raw/branch/main
REPO_CLONE_URL=http://10.0.0.52:3000/admin/lexis-markets.git
