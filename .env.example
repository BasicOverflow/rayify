# Workload backends for rayified projects (not admin UIs)
# Copy to .env and fill with your values. Real secrets stay in .env only.

# --- Ray (compute + job submit + model Serve HTTP) ---
RAY_ADDRESS=
RAY_NAMESPACE=
RAY_RUNTIME_ENV=
RAY_DASHBOARD_URL=
RAY_JOBS_API=
RAY_SERVE_URL=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- MinIO / S3 (datasets, checkpoints, artifacts) ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=
MINIO_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_ENDPOINT_URL=

# --- PostgreSQL (fast / slow pools if you have them) ---
POSTGRES_FAST_HOST=
POSTGRES_FAST_PORT=
POSTGRES_FAST_USER=
POSTGRES_FAST_PASSWORD=
POSTGRES_FAST_DB=
POSTGRES_FAST_URL=
POSTGRES_SLOW_HOST=
POSTGRES_SLOW_PORT=
POSTGRES_SLOW_USER=
POSTGRES_SLOW_PASSWORD=
POSTGRES_SLOW_DB=
POSTGRES_SLOW_URL=
DATABASE_URL=

# --- MongoDB ---
MONGODB_HOST=
MONGODB_PORT=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_URI=

# --- Neo4j (browser HTTP + bolt; slow / fast if multiple) ---
NEO4J_SLOW_HTTP=
NEO4J_SLOW_BOLT=
NEO4J_SLOW_USER=
NEO4J_SLOW_PASSWORD=
NEO4J_FAST_HTTP=
NEO4J_FAST_BOLT=
NEO4J_FAST_USER=
NEO4J_FAST_PASSWORD=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Metasearch (e.g. SearXNG JSON API) ---
SEARXNG_URL=
SEARXNG_SEARCH_URL=

# --- Git / OCI registry / private package index (e.g. Gitea) ---
GITEA_URL=
GITEA_USER=
GITEA_TOKEN=
GITEA_REGISTRY=
GITEA_PYPI_SIMPLE=
GITEA_PYPI_UPLOAD=
